# Application role: created by sql/000_app_role.sql, never a superuser.
DATABASE_URL=postgresql+asyncpg://tenant_vault_app:app_password@localhost:5435/tenant_vault
# Schema-owner role, used only by app/db/migrate.py. Never used by the running app.
ADMIN_DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:5435/tenant_vault
JWT_SECRET=change-me-to-something-random-in-every-real-deployment
WEBHOOK_SIGNING_SECRET=change-me
